# ==============================================================================
# PXT SMART INFRASTRUCTURE — PUBLIC PRODUCTION CLOUD DEPLOYMENT CONFIGURATION
# (Render / Railway / Fly.io / AWS / DigitalOcean / Vercel)
# ==============================================================================

# --- Backend Core Service ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=https://pxt-smart-infrastructure.vercel.app,https://your-custom-domain.com

# --- MQTT Messaging Broker ---
# In Docker/Cloud VM: MQTT_HOST is the broker service hostname (e.g. 'mqtt-broker' or '127.0.0.1')
MQTT_BIND_HOST=0.0.0.0
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_WS_PORT=9001
# Publicly advertised broker host (for remote physical IoT hardware gateways)
MQTT_PUBLIC_HOST=api.your-pxt-domain.com

# --- Security & Persistence ---
SECRET_KEY=GENERATE_A_SECURE_64_CHAR_RANDOM_SECRET_KEY_FOR_PRODUCTION
DATABASE_URL=sqlite+aiosqlite:////app/pxt_iot.db
# Or for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/pxt_db
TELEMETRY_RETENTION_DAYS=30
HEARTBEAT_TIMEOUT_SECONDS=10
SYSTEM_OPERATING_MODE=SIMULATION

# --- Frontend Build Environment Variables (Set in Vercel / Netlify Dashboard) ---
# IMPORTANT: Provide the full public HTTPS & WSS URL of your deployed backend service.
# DO NOT point this to localhost or 127.0.0.1 in production!
VITE_API_BASE_URL=https://pxt-backend.onrender.com
VITE_WS_BASE_URL=wss://pxt-backend.onrender.com/ws
